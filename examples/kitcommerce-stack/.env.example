# Copy to .env (git ignores it) and fill in the three secrets. Each is
# required: compose refuses to start and names the one that is missing.
#
#   openssl rand -hex 24

POSTGRES_PASSWORD=
GOCOMMERCE_ADMIN_TOKEN=
GOCOMMERCE_ADMIN_PASSWORD=
GOCOMMERCE_ADMIN_EMAIL=admin@example.com

# Where the browser finds the stack. Any *.localhost name reaches this machine.
HTTP_PORT=8000
SHOP_HOST=shop.localhost
ADMIN_HOST=admin.localhost

# The svelte-commerce commit to build. Changing it changes the connector too.
STOREFRONT_COMMIT=9bddb23d53fc555df58ae0378f0848c5a9578090

# 1 masks email addresses and phone numbers in the admin, for a public demo.
GOCOMMERCE_DEMO=
