# Every variable docker-compose.yml reads, for `docker compose up -d` (D143).
# Copy this to .env (git ignores it) and fill it in, or set the same names in
# the host's environment tab. Placeholders only: never commit a real secret.
# The comments in docker-compose.yml say what each one does.

# --- Required -------------------------------------------------------------
POSTGRES_PASSWORD=change-me                  # openssl rand -hex 24
GOCOMMERCE_ADMIN_TOKEN=change-me             # openssl rand -hex 32
GOCOMMERCE_ADMIN_EMAIL=you@example.com
GOCOMMERCE_ADMIN_PASSWORD=change-me          # the first operator's; used once

# --- Addresses ------------------------------------------------------------
ADMIN_DOMAIN=admin.example.com               # the panel; DNS A record to this server
GOCOMMERCE_PANEL_URL=https://admin.example.com
GOCOMMERCE_BASE_DOMAIN=shops.example.com     # stores at <slug>.shops.example.com; DNS *.shops.example.com
GOCOMMERCE_DOMAIN_TARGET=                    # this server's IP, shown to a store adding its own domain
STOREFRONT_STORE=                            # optional: the store every other host sells for
STOREFRONT_REF=gocomm                        # svelte-commerce branch or tag to build
STOREFRONT_ENGINE_URL=http://gocommerce:8080

# --- Proxy ----------------------------------------------------------------
PROXY_REPLICAS=1                             # 0 where another proxy holds 80/443 (Dokploy)
HTTP_PORT=80
HTTPS_PORT=443
CADDY_GLOBAL_OPTIONS=                        # e.g. local_certs for a trial on *.localhost
PORT=8080                                    # the engine's own port on the host

# --- Search ---------------------------------------------------------------
MEILI_MASTER_KEY=                            # at least 16 bytes: openssl rand -base64 32
MEILI_SEARCH_KEY=

# --- AI -------------------------------------------------------------------
ANTHROPIC_API_KEY=                           # the platform's key: every store's AI, paid from its AI credit
AI_PLATFORM_SMALL_MODEL=                     # empty: claude-haiku-5-5
AI_PLATFORM_SMALL_PRICES=                    # USD per million tokens: input,output,cache read,cache write
AI_PLATFORM_STRONG_MODEL=                    # empty: claude-sonnet-5-5
AI_PLATFORM_STRONG_PRICES=
AI_PLATFORM_USD_RATES=                       # e.g. INR=88.50 — stores in a currency without a rate get no platform AI
AI_FREE_TRIAL=                               # empty: INR=20000 (₹200); other currencies get ₹200's worth at the rates above

# --- Optional engine settings ---------------------------------------------
GOCOMMERCE_SECRETS_KEY=                      # openssl rand -base64 32; keep a copy off this server
GOCOMMERCE_SECRETS_KEY_PREVIOUS=
GOCOMMERCE_SIGNUP=
GOCOMMERCE_TRUSTED_PROXIES=                  # the storefront's and the proxy's addresses as the engine sees them
GOCOMMERCE_BRANDS=
GOCOMMERCE_POSTCODES_FILE=
ENGINE_DB_PASSWORD=
REPORTS_DB_PASSWORD=
GOCOMMERCE_REPORTS_DATABASE_URL=
GOCOMMERCE_TRAEFIK_TOKEN=                    # only behind Traefik (D113)
GOCOMMERCE_TRAEFIK_UPSTREAM=
GOCOMMERCE_TRAEFIK_CERT_RESOLVER=

# --- Email and SMS (each optional) ----------------------------------------
DEFAULT_EMAIL_FROM_ADDRESS=
RESEND_API_KEY=
RESEND_FROM=
RESEND_FROM_NAME=
SENDGRID_API_KEY=
SENDGRID_FROM=
SENDGRID_FROM_NAME=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ORDER_PLACED=
MSG91_TEMPLATE_PAYMENT_RECEIVED=
MSG91_TEMPLATE_ORDER_SHIPPED=
MSG91_TEMPLATE_ORDER_DELIVERED=
MSG91_TEMPLATE_ORDER_CANCELLED=
MSG91_TEMPLATE_REFUND_ISSUED=
MSG91_TEMPLATE_ORDER_CODE=
SMS_OTP_TEMPLATE_ID=
SMS_SENDER_ID=
