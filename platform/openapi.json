{
  "openapi": "3.0.3",
  "info": {
    "title": "gocommerce platform",
    "version": "1.1.0",
    "license": {
      "name": "MIT",
      "url": "https://opensource.org/licenses/MIT"
    },
    "description": "Multi-tenant mode (D70): one process and one PostgreSQL database serving many stores, each an ordinary gocommerce engine in a schema of its own. This is the platform operators' API, served only on the platform's own hosts (platform.<base domain> by default) and authorised with a platform token. A store's own API — the engine's whole contract, at /doc on the store's host — is a separate thing with separate credentials: a platform token opens no store's admin API, and a store's token opens nothing here.\n\nA store is reached at <slug>.<base domain>, at any custom domain attached to it, or on a shared API host by naming it in the X-Store header."
  },
  "paths": {
    "/api/platform/doc": {
      "get": {
        "summary": "This document",
        "security": [],
        "responses": {
          "200": {
            "description": "The platform API's OpenAPI document."
          }
        }
      }
    },
    "/api/platform/tls/allowed": {
      "get": {
        "summary": "May a certificate be issued for this host?",
        "security": [],
        "description": "For a proxy that issues certificates on demand (Caddy's on_demand_tls ask, for one): 200 for a host the platform serves — one of its own, or one attached to a store — and 404 for any other, so nobody can make the proxy fetch a certificate for a domain that merely points here. Unauthenticated, because the proxy calls it with nothing but the host, and it reveals nothing beyond whether that host is served.",
        "parameters": [
          {
            "name": "domain",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Served.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "allowed": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not served.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/health": {
      "get": {
        "summary": "How many stores, and which are not running",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "`unbooted` lists active stores whose engine failed to start; their hosts answer 503 until fixed and resumed.",
        "responses": {
          "200": {
            "description": "Counts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "stores": {
                          "type": "integer"
                        },
                        "running": {
                          "type": "integer"
                        },
                        "unbooted": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        },
                        "platform_hosts": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants": {
      "get": {
        "summary": "List stores",
        "security": [
          {
            "platformToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Every store, oldest first.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Tenant"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a store",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "Creates the store's schema, boots its engine with every migration applied, creates its first owner and attaches its domains — all or nothing: a failure part-way undoes the rest, so a slug is never left half-taken. The owner's password, when the platform generated it, and the store's own admin token are returned once and are not readable again (rotate the token to get a new one). The store answers at once at <slug>.<base domain> and at every domain given.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProvisionInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Provisioned"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A slug that is not lower-case letters, digits and single hyphens (or is reserved: platform, api, www, admin), no name, no owner email, a currency that is not three letters, or a domain that is not a host name or sits under the base domain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The slug, or one of the domains, is taken.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{slug}": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "get": {
        "summary": "Read a store",
        "security": [
          {
            "platformToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The store.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Tenant"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "patch": {
        "summary": "Rename, suspend or resume a store",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "Suspending stops the store's engine and its background work; its hosts answer 503 store_unavailable and its data is untouched. Resuming boots it again.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "active",
                      "suspended"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The store as it now is.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Tenant"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "An empty name, or a status that is not active or suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete a store and everything in it",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "Drops the store's schema, its domains and its uploads. Refused unless the store is suspended, and unless the slug is repeated as ?confirm=<slug> — deleting is always a second, separate decision.",
        "parameters": [
          {
            "name": "confirm",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "400": {
            "description": "confirm does not repeat the slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The store is not suspended.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{slug}/domains": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Attach a custom domain",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "The store answers on the domain at once. Point the domain's DNS at the platform; serving it over TLS is the proxy's job, which asks /api/platform/tls/allowed first.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "domain"
                ],
                "properties": {
                  "domain": {
                    "type": "string",
                    "example": "shop.example.com"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The store with its domains.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Tenant"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Not a host name, one of the platform's own hosts, or under the base domain.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The domain belongs to a store already.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{slug}/domains/{domain}": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "domain",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "delete": {
        "summary": "Detach a custom domain",
        "security": [
          {
            "platformToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The store with its remaining domains.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Tenant"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{slug}/owners": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Give somebody an owner's login on a store",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "The platform's way into a store whose operators are locked out, or a second owner at the customer's request. With no password one is generated and returned once.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email"
                ],
                "properties": {
                  "email": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "email": {
                          "type": "string"
                        },
                        "password": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "No email, or a password the store refuses.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "The store is suspended, or the address already has a login there.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/platform/tenants/{slug}/token": {
      "parameters": [
        {
          "name": "slug",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "summary": "Rotate a store's admin token",
        "security": [
          {
            "platformToken": []
          }
        ],
        "description": "Replaces the store's static admin token and restarts its engine with the new one; the old token stops working when this answers.",
        "responses": {
          "200": {
            "description": "The new token, shown once.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "admin_token": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "No platform token, or one the platform does not hold.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "There is no store with that slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "platformToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "A platform operator's token (GOCOMMERCE_PLATFORM_TOKEN). Not a store's token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string"
              },
              "message": {
                "type": "string"
              }
            }
          }
        }
      },
      "Tenant": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "slug": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "suspended"
            ]
          },
          "currency": {
            "type": "string",
            "description": "Empty takes the platform's default."
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Custom domains, the first being the one the store's panel and emails name. <slug>.<base domain> is always served besides and is not listed."
          },
          "host": {
            "type": "string",
            "description": "Where the store is reached first: its first custom domain, else <slug>.<base domain>."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ProvisionInput": {
        "type": "object",
        "required": [
          "slug",
          "name",
          "owner_email"
        ],
        "properties": {
          "slug": {
            "type": "string",
            "example": "acme"
          },
          "name": {
            "type": "string"
          },
          "currency": {
            "type": "string",
            "example": "EUR"
          },
          "languages": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "domains": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "owner_email": {
            "type": "string"
          },
          "owner_password": {
            "type": "string",
            "description": "Omit to have one generated and returned once."
          }
        }
      },
      "Provisioned": {
        "type": "object",
        "properties": {
          "tenant": {
            "$ref": "#/components/schemas/Tenant"
          },
          "owner_email": {
            "type": "string"
          },
          "owner_password": {
            "type": "string",
            "description": "Present only when the platform generated it."
          },
          "admin_token": {
            "type": "string",
            "description": "The store's own static API token: it opens this store's admin API and no other. Shown once."
          }
        }
      }
    }
  }
}
