{
  "paths": {
    "/api/admin/x/telegram-alerts/alerts": {
      "get": {
        "tags": ["telegram-alerts"],
        "summary": "Every Telegram alert",
        "description": "One per event the module sends — order.created, order.paid, order.cancelled and order.returned, in that order — each with the owner's switch and wording, or the defaults where nothing was changed. Needs alerts.read.",
        "responses": {
          "200": {
            "description": "The alerts.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/TelegramAlert" } }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" }
        }
      },
      "post": {
        "tags": ["telegram-alerts"],
        "summary": "Create an event's alert",
        "description": "Stores the owner's switch and wording for an event that has none stored yet. An event that already has its row is a 409: change it with PATCH. Needs alerts.write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event"],
                "properties": {
                  "event": { "type": "string", "enum": ["order.created", "order.paid", "order.cancelled", "order.returned"] },
                  "template": { "type": "string", "description": "Go text/template over the alert's data. Empty keeps the default wording. Refused when it does not render for a sample order." },
                  "active": { "type": "boolean", "default": true }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/TelegramAlert" } } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "403": { "$ref": "#/components/responses/Forbidden" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/alerts/{event}": {
      "parameters": [
        {
          "name": "event",
          "in": "path",
          "required": true,
          "schema": { "type": "string", "enum": ["order.created", "order.paid", "order.cancelled", "order.returned"] }
        }
      ],
      "get": {
        "tags": ["telegram-alerts"],
        "summary": "One event's alert",
        "description": "Needs alerts.read.",
        "responses": {
          "200": {
            "description": "The alert.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/TelegramAlert" } } }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "tags": ["telegram-alerts"],
        "summary": "Switch or reword an event's alert",
        "description": "Either field, or both; what is left out stays as it is. Wording that does not render for a sample order is refused as it is typed rather than on the next sale. Needs alerts.write.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "template": { "type": "string" },
                  "active": { "type": "boolean" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The alert as it now stands.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/TelegramAlert" } } }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "tags": ["telegram-alerts"],
        "summary": "Restore an event's alert to its defaults",
        "description": "Forgets the owner's switch and wording for the event, which puts the default back: on, with the wording in code. Nothing stored is the same answer. Needs alerts.write.",
        "responses": {
          "200": {
            "description": "The alert with its defaults.",
            "content": {
              "application/json": {
                "schema": { "type": "object", "properties": { "data": { "$ref": "#/components/schemas/TelegramAlert" } } }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/preview": {
      "post": {
        "tags": ["telegram-alerts"],
        "summary": "Preview an alert with a sample order",
        "description": "Fills the event's wording — or the template sent, to try one before saving it — with a made-up order in the store's currency, and returns the message as the phone would show it. Wording that does not render is still a 200, with `error` saying why and no `text`: a panel previews as the owner types, and half-typed wording is its ordinary input. Sends nothing. Needs alerts.read.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["event"],
                "properties": {
                  "event": { "type": "string", "enum": ["order.created", "order.paid", "order.cancelled", "order.returned"] },
                  "template": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "event": { "type": "string" },
                        "text": { "type": "string", "example": "New order GC-001042: ₹1,299.00\n1 x Cotton kurta (M / Indigo), 1 x Silk dupatta\nCustomer: Asha\nPayment: cod, pending" },
                        "error": { "type": "string", "description": "Why the wording does not render; absent when it does." }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/chats": {
      "get": {
        "tags": ["telegram-alerts"],
        "summary": "The chats the bot has heard from",
        "description": "Asks Telegram (getUpdates, confirming nothing) which chats have written to the bot in the last day, newest first, so the owner picks theirs instead of finding a chat ID. Uses the bot token saved on the plugin. Needs alerts.write: it is part of setting the bot up, and the list is the names of whoever messaged it.",
        "responses": {
          "200": {
            "description": "The chats; empty until somebody messages the bot or adds it to a group.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/TelegramChat" } }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "422": { "$ref": "#/components/responses/TelegramFailed" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/test": {
      "post": {
        "tags": ["telegram-alerts"],
        "summary": "Send a test message",
        "description": "One message to the chosen chat, now, with the saved bot token. Works before the alerts are switched on, so the owner sees the bot and the chat work before an order depends on them. Needs alerts.write.",
        "responses": {
          "200": {
            "description": "Telegram accepted it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "sent": { "type": "boolean" },
                        "chat_id": { "type": "string" }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" },
          "422": { "$ref": "#/components/responses/TelegramFailed" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/deliveries": {
      "get": {
        "tags": ["telegram-alerts"],
        "summary": "Whether the alerts arrived",
        "description": "One row per event, newest first, without the message text. `state` is derived from the worker's own columns: pending while it is still trying, delivered, or dead once Telegram refused it or twelve attempts ran out. Needs alerts.read.",
        "parameters": [
          {
            "name": "state",
            "in": "query",
            "schema": { "type": "string", "enum": ["pending", "delivered", "dead"] }
          },
          { "$ref": "#/components/parameters/Limit" },
          { "$ref": "#/components/parameters/PageNumber" },
          { "$ref": "#/components/parameters/Offset" }
        ],
        "responses": {
          "200": {
            "description": "A page of deliveries.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "array", "items": { "$ref": "#/components/schemas/TelegramAlertDelivery" } },
                    "meta": { "$ref": "#/components/schemas/ListMeta" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/Validation" }
        }
      }
    },
    "/api/admin/x/telegram-alerts/deliveries/{id}/retry": {
      "post": {
        "tags": ["telegram-alerts"],
        "summary": "Send an alert again",
        "description": "Puts an undelivered alert back in the queue with a fresh set of attempts — what to do with one Telegram refused, once the chat or the token is fixed. A delivered alert is not found. Needs alerts.write.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "integer", "format": "int64" }
          }
        ],
        "responses": {
          "200": {
            "description": "Queued.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": { "type": "object", "properties": { "queued": { "type": "boolean" } } }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      }
    }
  },
  "components": {
    "responses": {
      "TelegramFailed": {
        "description": "Telegram refused (`telegram_refused`, with its reason in words the owner can act on) or could not be reached (`telegram_unreachable`). Never carries the bot token.",
        "content": {
          "application/json": { "schema": { "$ref": "#/components/schemas/ErrorEnvelope" } }
        }
      }
    },
    "schemas": {
      "TelegramAlert": {
        "type": "object",
        "properties": {
          "event": { "type": "string" },
          "title": { "type": "string", "example": "New order" },
          "description": { "type": "string" },
          "template": { "type": "string", "description": "Go text/template over the alert's flat string data." },
          "active": { "type": "boolean" },
          "customized": { "type": "boolean", "description": "Whether the wording differs from the default." },
          "default_template": { "type": "string" },
          "variables": {
            "type": "array",
            "items": { "type": "string" },
            "description": "The keys the wording may name: the engine's order data, plus total (written for reading, in the order's currency), customer_first_name, customer_phone, order_url (the order in the panel, only when the panel's address is configured) and store_name."
          },
          "updated_at": { "type": "string", "format": "date-time", "nullable": true }
        }
      },
      "TelegramChat": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "description": "A string: a group's id is a large negative number that a float would round.", "example": "-1001234567890" },
          "type": { "type": "string", "enum": ["private", "group", "supergroup", "channel"] },
          "title": { "type": "string" },
          "username": { "type": "string" }
        }
      },
      "TelegramAlertDelivery": {
        "type": "object",
        "properties": {
          "id": { "type": "integer", "format": "int64" },
          "event_id": { "type": "string" },
          "event_name": { "type": "string" },
          "order_id": { "type": "integer", "format": "int64" },
          "order_number": { "type": "string", "example": "GC-000042" },
          "state": { "type": "string", "enum": ["pending", "delivered", "dead"] },
          "attempts": { "type": "integer" },
          "last_status": { "type": "integer" },
          "last_error": { "type": "string" },
          "available_at": { "type": "string", "format": "date-time" },
          "delivered_at": { "type": "string", "format": "date-time", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" }
        }
      }
    }
  }
}
