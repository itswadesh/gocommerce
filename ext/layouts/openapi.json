{
  "paths": {
    "/x/layouts/starter/1/{file}": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "A picture of the starting home page",
        "description": "One of the pictures the starting home page names (D140): the hero, its phone crop and the lookbook (Unsplash photographs) and the four tiles (made with Google Gemini), credited in ext/layouts/starter/README.md, served from the engine's own binary, so every store's storefront and the editor's preview load them. No store need be named. Public, like a store's own media, and cached as immutable: a changed picture takes a new file name, and the old one stays.",
        "parameters": [
          {
            "name": "file",
            "in": "path",
            "required": true,
            "description": "The picture's file name, such as `hero.webp`.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The picture.",
            "content": {
              "image/webp": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/x/layouts/theme": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "The storefront's design tokens",
        "description": "The theme settings published with the home page (D127), for every page of the storefront to apply, without the home page's products. Answered `Cache-Control: public, max-age=30`. With `preview=<key>` from the editor, the saved draft's instead, answered `no-store`. An empty `settings` means the storefront keeps its own look. Before the home page's first publish, the starting home page's settings, with no `revision`. 404 while the `layouts` plugin is off.",
        "parameters": [
          {
            "name": "preview",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A preview key from the editor."
          }
        ],
        "responses": {
          "200": {
            "description": "The tokens.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutPublicTheme"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Switched off, nothing published, or an expired preview key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/x/layouts/{page}": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "A storefront page as the shop arranged it",
        "description": "The published page (D125): its shown sections in order, each `{id, type, settings}`, and each product grid's `products` resolved live — active, on the request's channel, translated. Hidden sections are left out, and so are settings whose plugin is off. The published `header` and `footer` are answered `Cache-Control: public, max-age=30`. With `preview=<key>` from the editor, the saved draft instead, answered `Cache-Control: no-store` and `X-Robots-Tag: noindex`. 404 while the `layouts` plugin is off, or for any page but `home` while nothing is published: the storefront then draws its built-in page. A `home` never published is answered as the starting home page (D140), with no `revision`.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          },
          {
            "name": "preview",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "A preview key from the editor."
          }
        ],
        "responses": {
          "200": {
            "description": "The page.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutPublicPage"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Switched off, not published, or an expired preview key.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/x/layouts/sections": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "The section library",
        "description": "Every section type a page can hold, with the fields the editor draws its form from and the engine validates against, and the themes a page may name. A type whose `requires` plugin is off or absent is left out. `theme_settings` lists the design tokens in titled groups, with the same field shapes.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "The registry.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "sections": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "themes": {
                          "type": "array",
                          "items": {
                            "type": "object"
                          }
                        },
                        "pages": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/x/layouts/{page}": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "A page's draft and what is published",
        "description": "The draft (or, before the first save, the starting template: `saved` false, `version` 0), the published revision, and whether the two differ.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "200": {
            "description": "The page as the editor works on it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Not a page that can be arranged.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      },
      "put": {
        "tags": [
          "layouts"
        ],
        "summary": "Save the draft",
        "description": "Replaces the draft with `document`, validated against the section library: an unknown type, a link that is not a web address or a path, a setting out of range, over 50 sections or 256 KB is 400 `validation_failed` naming the section. `version` is the one it was read at (0 for the first save); a stale one is 409 `stale_draft` and nothing is saved.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "200": {
            "description": "The page as the editor works on it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "The document breaks a rule; the message names the section.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "Somebody saved the page after it was read.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version",
                  "document"
                ],
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "document": {
                    "$ref": "#/components/schemas/LayoutDocument"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/x/layouts/{page}/publish": {
      "post": {
        "tags": [
          "layouts"
        ],
        "summary": "Publish the draft",
        "description": "Makes the saved draft at `version` what the storefront shows, as a new immutable revision, in one transaction. 409 when the draft was saved since, or never saved.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "200": {
            "description": "The page as the editor works on it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Stale or unsaved draft.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "description": "The draft's version as it was read."
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/x/layouts/{page}/revisions": {
      "get": {
        "tags": [
          "layouts"
        ],
        "summary": "Published versions",
        "description": "The page's published revisions, newest first: number, when, by whom, how many sections, and which revision a rollback restored.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "200": {
            "description": "The revisions.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/LayoutRevision"
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      }
    },
    "/api/admin/x/layouts/{page}/rollback": {
      "post": {
        "tags": [
          "layouts"
        ],
        "summary": "Roll back",
        "description": "Publishes an earlier revision's document again, as a new revision, and makes it the draft.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "200": {
            "description": "The page as the editor works on it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "No such revision.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "revision"
                ],
                "properties": {
                  "revision": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/admin/x/layouts/{page}/reset": {
      "post": {
        "tags": [
          "layouts"
        ],
        "summary": "Reset the draft",
        "description": "Throws the draft away: it becomes the published document again, or the starting page when nothing has been published. Names the version it was read at, like a save; a stale one is 409 `stale_draft`. The storefront is not touched.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version"
                ],
                "properties": {
                  "version": {
                    "type": "integer"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The page as the editor works on it.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "409": {
            "description": "Somebody saved the page since it was read (`stale_draft`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      }
    },
    "/api/admin/x/layouts/{page}/preview": {
      "post": {
        "tags": [
          "layouts"
        ],
        "summary": "A preview key",
        "description": "A key that lets the storefront show the saved draft for 30 minutes: open the storefront with `?preview=<key>` (the theme editor frames it with `&editor=<panel origin>` too). Before the first save the draft is the starting page, and the key shows that.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: `home`, the `product` and `collection` templates (D129), or the `header` and `footer` drawn on every page (D131)."
          }
        ],
        "responses": {
          "201": {
            "description": "The key.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "token": {
                          "type": "string"
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        },
                        "storefront": {
                          "type": "string",
                          "description": "Where shoppers reach the store, as https://host: its primary verified domain, else its address under the base domain; empty when it has neither."
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "security": [
          {
            "adminToken": []
          }
        ]
      }
    },
    "/api/admin/x/layouts/{page}/schedule": {
      "post": {
        "tags": [
          "layouts"
        ],
        "summary": "Schedule the page's draft to publish",
        "description": "Sets the saved draft at `version` to publish at `publish_at` (D129), within half a minute of it, through the same publish as the button: a revision marked `scheduled`, `published_by` the person who scheduled it. The draft is copied as it is now; later edits keep saving to the draft and are not in it, which the state's `scheduled.outdated` says. A page has one schedule, and scheduling again replaces it. Publishing by hand, rolling back and resetting leave it alone. Needs `layouts.write`.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: the home page, or the template every product or every collection is drawn in."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "version",
                  "publish_at"
                ],
                "properties": {
                  "version": {
                    "type": "integer",
                    "description": "The draft's version, as read."
                  },
                  "publish_at": {
                    "type": "string",
                    "format": "date-time",
                    "description": "When to publish: in the future, at most a year ahead."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The page's state, with its schedule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "A time gone by, or more than a year ahead.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "409": {
            "description": "The page has not been saved, or the draft has been saved since `version` (`stale_draft`).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "layouts"
        ],
        "summary": "Cancel the page's scheduled publish",
        "description": "Calls off the page's scheduled publish. With none, the answer is the same. Needs `layouts.write`.",
        "parameters": [
          {
            "name": "page",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "home",
                "product",
                "collection",
                "header",
                "footer"
              ]
            },
            "description": "The page: the home page, or the template every product or every collection is drawn in."
          }
        ],
        "responses": {
          "200": {
            "description": "The page's state, without a schedule.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/LayoutState"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "LayoutSection": {
        "type": "object",
        "required": [
          "id",
          "type"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,40}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "announcement-bar",
              "hero",
              "product-grid",
              "image-with-text",
              "rich-text",
              "benefits"
            ]
          },
          "enabled": {
            "type": "boolean"
          },
          "settings": {
            "type": "object",
            "additionalProperties": true
          }
        }
      },
      "LayoutDocument": {
        "type": "object",
        "properties": {
          "schema_version": {
            "type": "integer"
          },
          "theme": {
            "type": "string",
            "default": "default"
          },
          "theme_settings": {
            "$ref": "#/components/schemas/LayoutThemeSettings"
          },
          "sections": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "$ref": "#/components/schemas/LayoutSection"
            }
          }
        }
      },
      "LayoutRevision": {
        "type": "object",
        "properties": {
          "number": {
            "type": "integer"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "published_by": {
            "type": "string"
          },
          "restored_from": {
            "type": "integer",
            "nullable": true
          },
          "sections": {
            "type": "integer"
          },
          "scheduled": {
            "type": "boolean",
            "description": "It went live at a time set beforehand; `published_by` is who set it."
          }
        }
      },
      "LayoutState": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "document": {
            "$ref": "#/components/schemas/LayoutDocument"
          },
          "version": {
            "type": "integer"
          },
          "saved": {
            "type": "boolean"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_by": {
            "type": "string"
          },
          "published": {
            "allOf": [
              {
                "$ref": "#/components/schemas/LayoutRevision"
              }
            ],
            "nullable": true
          },
          "changed": {
            "type": "boolean"
          },
          "scheduled": {
            "description": "The publish waiting for its time, or null.",
            "nullable": true,
            "allOf": [
              {
                "$ref": "#/components/schemas/LayoutSchedule"
              }
            ]
          }
        }
      },
      "LayoutPublicPage": {
        "type": "object",
        "properties": {
          "page": {
            "type": "string"
          },
          "theme": {
            "type": "string"
          },
          "revision": {
            "type": "integer"
          },
          "preview": {
            "type": "boolean"
          },
          "theme_settings": {
            "$ref": "#/components/schemas/LayoutThemeSettings"
          },
          "sections": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string"
                },
                "type": {
                  "type": "string"
                },
                "settings": {
                  "type": "object",
                  "additionalProperties": true
                },
                "products": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Product"
                  }
                },
                "collections": {
                  "type": "array",
                  "description": "A collection list's collections, in the order picked; deleted ones left out.",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "integer",
                        "format": "int64"
                      },
                      "slug": {
                        "type": "string"
                      },
                      "title": {
                        "type": "string"
                      },
                      "image": {
                        "type": "string"
                      },
                      "description": {
                        "type": "string",
                        "description": "The first line of the collection's description, cut at a word near 160 characters; absent when it has none."
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "LayoutThemeSettings": {
        "type": "object",
        "description": "The store's design tokens (D127, D128, D155). Every key is optional; an unset one keeps the storefront's own value, and a new store starts with the starter's (`sale`, the type, spacing, card, list and product page keys, all but `pdp_size_guide` and `eyebrow_case`). Colours are `#rrggbb`: `sale` colours the \"% off\" and offer lines. Fonts are keys from the registry's list; `radius` is none, small, medium or large; `product_image_ratio` square (1:1), portrait (3:4), tall (2:3) or landscape (4:3); `product_image_fit` fill (crop to the frame) or whole (fit inside it). `type_scale` sets the body text at 14, 16 or 18px. `eyebrow_case` `upper` draws the small line above a section's heading in spaced capitals; `sentence`, like unset, draws it as typed. `card_badge` labels a card's picture with the product's own badge (`metadata.badge`, D157), its first tag or its first highlight. `pdp_low_stock_at` shows \"only N left\" at or below N, and never at 0; `pdp_size_guide` is a path on the storefront.",
        "properties": {
          "background": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "text": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "accent": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "accent_text": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "muted": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "sale": {
            "type": "string",
            "pattern": "^#[0-9a-f]{6}$"
          },
          "heading_font": {
            "type": "string"
          },
          "body_font": {
            "type": "string"
          },
          "type_scale": {
            "type": "string",
            "enum": [
              "compact",
              "standard",
              "large"
            ]
          },
          "heading_weight": {
            "type": "string",
            "enum": [
              "medium",
              "semibold",
              "bold",
              "extrabold"
            ]
          },
          "eyebrow_case": {
            "type": "string",
            "enum": [
              "sentence",
              "upper"
            ]
          },
          "density": {
            "type": "string",
            "enum": [
              "compact",
              "comfortable",
              "spacious"
            ]
          },
          "radius": {
            "type": "string",
            "enum": [
              "none",
              "small",
              "medium",
              "large"
            ]
          },
          "product_image_ratio": {
            "type": "string",
            "enum": [
              "square",
              "portrait",
              "tall",
              "landscape"
            ]
          },
          "product_image_fit": {
            "type": "string",
            "enum": [
              "fill",
              "whole"
            ]
          },
          "card_badge": {
            "type": "string",
            "enum": [
              "none",
              "product_badge",
              "first_tag",
              "first_highlight"
            ]
          },
          "card_vendor": {
            "type": "boolean"
          },
          "card_title_lines": {
            "type": "string",
            "enum": [
              "one",
              "two"
            ]
          },
          "card_rating": {
            "type": "boolean"
          },
          "card_discount": {
            "type": "boolean"
          },
          "card_wishlist": {
            "type": "boolean"
          },
          "card_add_to_cart": {
            "type": "boolean"
          },
          "card_second_image": {
            "type": "boolean"
          },
          "list_columns_mobile": {
            "type": "string",
            "enum": [
              "one",
              "two"
            ]
          },
          "list_columns_desktop": {
            "type": "string",
            "enum": [
              "three",
              "four",
              "five"
            ]
          },
          "list_subcategories": {
            "type": "boolean"
          },
          "list_quick_filters": {
            "type": "boolean"
          },
          "list_filters_desktop": {
            "type": "string",
            "enum": [
              "sidebar",
              "drawer"
            ]
          },
          "list_mobile_bar": {
            "type": "boolean"
          },
          "pdp_sticky_buy": {
            "type": "boolean"
          },
          "pdp_gallery": {
            "type": "string",
            "enum": [
              "carousel",
              "grid"
            ]
          },
          "pdp_highlights_grid": {
            "type": "boolean"
          },
          "pdp_delivery_check": {
            "type": "boolean"
          },
          "pdp_low_stock_at": {
            "type": "integer",
            "minimum": 0,
            "maximum": 20
          },
          "pdp_size_guide": {
            "type": "string",
            "pattern": "^/",
            "maxLength": 200
          }
        }
      },
      "LayoutPublicTheme": {
        "type": "object",
        "properties": {
          "revision": {
            "type": "integer"
          },
          "preview": {
            "type": "boolean"
          },
          "settings": {
            "$ref": "#/components/schemas/LayoutThemeSettings"
          }
        }
      },
      "LayoutSchedule": {
        "type": "object",
        "description": "A draft set to publish at a time.",
        "properties": {
          "publish_at": {
            "type": "string",
            "format": "date-time"
          },
          "scheduled_at": {
            "type": "string",
            "format": "date-time"
          },
          "scheduled_by": {
            "type": "string"
          },
          "version": {
            "type": "integer",
            "description": "The draft's version that was scheduled."
          },
          "outdated": {
            "type": "boolean",
            "description": "The draft has been saved since: those edits are not in what publishes."
          }
        }
      }
    }
  }
}
