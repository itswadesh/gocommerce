{
  "paths": {
    "/x/reviews": {
      "get": {
        "tags": [
          "reviews"
        ],
        "summary": "A product's approved reviews, with the numbers",
        "description": "Approved reviews only, newest first, without the reviewer's email. `summary` is the count, the average to one decimal, and how many gave each rating. 404 while the plugin is off.",
        "parameters": [
          {
            "name": "product_id",
            "in": "query",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "The reviews and their summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "reviews": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/PublicReview"
                          }
                        },
                        "summary": {
                          "$ref": "#/components/schemas/ReviewSummary"
                        },
                        "meta": {
                          "type": "object",
                          "properties": {
                            "total": {
                              "type": "integer"
                            },
                            "limit": {
                              "type": "integer"
                            },
                            "offset": {
                              "type": "integer"
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "post": {
        "tags": [
          "reviews"
        ],
        "summary": "Post a review",
        "description": "A rating from 1 to 5, a name, an email and a few words, for a product that exists. It waits for moderation unless the Reviews screen approves on sight, and is marked verified when the email has bought the product; the Reviews screen can make that a condition. `website` is a honeypot — a field no person sees. 404 while the plugin is off.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReviewInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Received, with the status it landed in.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string"
                        },
                        "verified": {
                          "type": "boolean"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/admin/x/reviews": {
      "get": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Every review, for moderation",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "Newest first, with the product's title and the reviewer's email. Needs catalog.read.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "pending",
                "approved",
                "rejected"
              ]
            }
          },
          {
            "name": "product_id",
            "in": "query",
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "A name, email, title or body fragment."
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of reviews.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Review"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/reviews/{id}": {
      "patch": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Approve or reject a review, or reply under it",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "pending",
                      "approved",
                      "rejected"
                    ]
                  },
                  "reply": {
                    "type": "string",
                    "description": "The store's public answer under the review; empty removes it."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The review.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/Review"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Delete a review",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/admin/x/reviews/export": {
      "get": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Export every review as CSV",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "Columns are `id, product_slug, product_title, name, email, rating, title, body, status, verified, reply, created_at`, newest first. The product is named by slug, the way the product file names it, and `product_title` is written for the reader only. A review whose product has since been deleted is still in the file with its slug blank — it is still a fact about the store. Needs data.export rather than catalogue.read: reading a page of reviews on a screen and walking out with every reviewer's email address are different acts.",
        "responses": {
          "200": {
            "description": "A CSV file.",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/reviews/import": {
      "post": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Add or moderate reviews from a CSV",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "A row carrying an `id` the store has updates that review; every other row is a new one and needs `product_slug`, `name`, `rating` and `body`. A blank cell says nothing and leaves the column alone, which is what lets an operator export, paste one column of statuses back, and import it. `verified` is the store's own judgement when the file does not mention it — an email that has bought the product — and the file's when it does, because a store moving in carries verifications the orders here cannot show. Each row is its own transaction, so a row naming a product that is not here is a row error and the rest still land. `dry_run=1` reports what would happen and writes nothing.",
        "parameters": [
          {
            "$ref": "#/components/parameters/DryRun"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "text/csv": {
              "schema": {
                "type": "string"
              }
            }
          }
        },
        "responses": {
          "200": {
            "$ref": "#/components/responses/ImportResponse"
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/reviews/products/{id}/summarize": {
      "post": {
        "tags": [
          "admin:reviews"
        ],
        "summary": "Summarize what shoppers praise and complain about in a product's reviews",
        "description": "Requires reviews.read. Runs the AI gateway's `reviews.summarize` task over the product's published reviews: the newest 50 at most, and fewer when their words pass about 32 KB. The model is sent each review's id, rating, title and body, never the reviewer's name or email, and the product's title. Each theme cites the reviews it comes from; a theme citing a review that was not sent fails the task's check and goes to the strong model. `count`, `rating` and the order of the themes are worked out by the engine, not the model. With fewer than 3 published reviews no model is asked and `state` is `too_few`. The same reviews asked about again are answered from the gateway's cache at no cost (`outcome` `cached`). Every run is recorded under AI usage.",
        "security": [
          {
            "adminToken": []
          }
        ],
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "responses": {
          "200": {
            "description": "The summary.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ReviewDigest"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "description": "No summary was made, and `error.code` says why: `ai_unavailable` (the binary has no AI gateway), `ai_not_ready` (the gateway is off, or missing its key, cap or a model's price), `ai_data_kept_in` (Share message bodies is off) `ai_budget_exhausted` (this month's cap cannot cover the call) or `ai_credit_exhausted` (the store's AI credit is spent; the message says whether it was the free trial).",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          },
          "502": {
            "description": "`ai_failed`: the provider failed, or neither model's answer passed the checks. Asking again may succeed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ReviewInput": {
        "type": "object",
        "required": [
          "product_id",
          "name",
          "email",
          "rating",
          "body"
        ],
        "properties": {
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "rating": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          },
          "website": {
            "type": "string",
            "description": "Honeypot. Leave empty."
          }
        }
      },
      "PublicReview": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "rating": {
            "type": "integer"
          },
          "title": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "verified": {
            "type": "boolean",
            "description": "The email bought the product."
          },
          "reply": {
            "type": "string"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Review": {
        "allOf": [
          {
            "$ref": "#/components/schemas/PublicReview"
          },
          {
            "type": "object",
            "properties": {
              "product_id": {
                "type": "integer",
                "format": "int64"
              },
              "product": {
                "type": "string"
              },
              "email": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "pending",
                  "approved",
                  "rejected"
                ]
              },
              "updated_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          }
        ]
      },
      "ReviewSummary": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "count": {
            "type": "integer"
          },
          "average": {
            "type": "number",
            "description": "To one decimal; 0 with no reviews."
          },
          "distribution": {
            "type": "object",
            "additionalProperties": {
              "type": "integer"
            },
            "description": "How many gave each rating, 1 to 5."
          }
        }
      },
      "ReviewTheme": {
        "type": "object",
        "properties": {
          "topic": {
            "type": "string",
            "enum": [
              "fit",
              "quality",
              "colour",
              "delivery",
              "value",
              "other"
            ]
          },
          "label": {
            "type": "string",
            "description": "A short phrase, written by the model."
          },
          "count": {
            "type": "integer",
            "description": "How many distinct reviews the theme cites, counted by the engine."
          },
          "review_ids": {
            "type": "array",
            "items": {
              "type": "integer",
              "format": "int64"
            },
            "description": "The reviews the theme cites, each once."
          }
        }
      },
      "ReviewDigest": {
        "type": "object",
        "properties": {
          "product_id": {
            "type": "integer",
            "format": "int64"
          },
          "product": {
            "type": "string"
          },
          "state": {
            "type": "string",
            "enum": [
              "summarized",
              "too_few"
            ]
          },
          "rating": {
            "$ref": "#/components/schemas/ReviewSummary"
          },
          "read": {
            "type": "integer",
            "description": "How many of the newest published reviews were read; fewer than `rating.count` when some were left out."
          },
          "praise": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewTheme"
            },
            "description": "Most cited first."
          },
          "complaints": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ReviewTheme"
            },
            "description": "Most cited first."
          },
          "reviews": {
            "type": "array",
            "description": "The reviews the themes cite, newest first.",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer",
                  "format": "int64"
                },
                "rating": {
                  "type": "integer"
                },
                "title": {
                  "type": "string"
                },
                "body": {
                  "type": "string"
                }
              }
            }
          },
          "outcome": {
            "type": "string",
            "enum": [
              "ok",
              "cached",
              "deterministic"
            ]
          },
          "execution_id": {
            "type": "integer",
            "format": "int64",
            "description": "The run's record under AI usage."
          },
          "cost_micro_minor": {
            "type": "integer",
            "format": "int64",
            "description": "What this run cost, in millionths of a minor unit; 0 from the cache or without a model."
          },
          "currency": {
            "type": "string"
          }
        }
      }
    }
  }
}
