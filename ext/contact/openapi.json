{
  "paths": {
    "/x/contact/messages": {
      "post": {
        "tags": [
          "contact"
        ],
        "summary": "Send the store a message",
        "description": "The storefront's contact form. A name, an email and a message are required; a subject, a phone and an order number are welcome. `website` is a honeypot — a field no person sees — and a filled one is accepted and dropped. The operator is told by email at the address the Plugins screen holds, and that announcement lands in Notifications. 404 while the plugin is off.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactMessageInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Received.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/admin/x/contact/messages": {
      "get": {
        "tags": [
          "admin:contact"
        ],
        "summary": "The inbox",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "Newest first, without their threads. Needs contact.read. Where personal data is masked (a demo store, an agent key) the addresses come back masked and `q` does not match them.",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "new",
                "replied",
                "archived"
              ]
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            },
            "description": "A name, email or subject fragment, or an order number."
          },
          {
            "$ref": "#/components/parameters/Limit"
          },
          {
            "$ref": "#/components/parameters/PageNumber"
          },
          {
            "$ref": "#/components/parameters/Offset"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of messages.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ContactMessage"
                      }
                    },
                    "meta": {
                      "$ref": "#/components/schemas/ListMeta"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/admin/x/contact/messages/{id}": {
      "get": {
        "tags": [
          "admin:contact"
        ],
        "summary": "One message, with its replies",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "Needs contact.read.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "responses": {
          "200": {
            "description": "The message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ContactMessage"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "admin:contact"
        ],
        "summary": "Mark a message replied or archived, or note something on it",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "For a message answered somewhere else — by phone, or from the operator's own mail — and for notes. Replying from the panel marks it replied by itself. Needs contact.write.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": [
                      "new",
                      "replied",
                      "archived"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The message.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ContactMessage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "delete": {
        "tags": [
          "admin:contact"
        ],
        "summary": "Delete a message",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "The message and its replies. Needs contact.write.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/admin/x/contact/messages/{id}/reply": {
      "post": {
        "tags": [
          "admin:contact"
        ],
        "summary": "Reply to a message by email",
        "security": [
          {
            "adminToken": []
          }
        ],
        "description": "Sends the reply to the shopper now, with the `contact.reply` email, through the store's email provider — from its sender, with its reply-to address, so the answer comes back to the shop. Once the provider has taken it, the reply joins the message's thread with who sent it, and the message is marked replied, in one transaction. A reply that did not go is not recorded and the message is left as it was: 409 when the store has no email provider that delivers, 422 when the provider refused it (with the provider's reason) or could not be reached; every attempt is on the Notifications screen. An empty subject is \"Re: \" and the message's subject. 403 `demo_frozen` on a public demo, which sends no replies. Needs contact.reply.",
        "parameters": [
          {
            "$ref": "#/components/parameters/PathID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ContactReplyInput"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Sent and recorded: the message, with its thread.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "$ref": "#/components/schemas/ContactMessage"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/Validation"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "description": "The email provider refused the reply (`provider_refused`, with its reason) or could not be reached (`provider_unreachable`). Nothing was recorded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ContactMessageInput": {
        "type": "object",
        "required": [
          "name",
          "email",
          "body"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string",
            "maxLength": 5000
          },
          "order_number": {
            "type": "string"
          },
          "website": {
            "type": "string",
            "description": "Honeypot. Leave empty."
          }
        }
      },
      "ContactReplyInput": {
        "type": "object",
        "required": [
          "body"
        ],
        "properties": {
          "subject": {
            "type": "string",
            "maxLength": 200,
            "description": "Empty means \"Re: \" and the message's own."
          },
          "body": {
            "type": "string",
            "maxLength": 5000
          }
        }
      },
      "ContactReply": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "sent_by": {
            "type": "string",
            "description": "The operator's address, \"api key: …\" for a key, or \"token\" for the static admin token. Masked where addresses are."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ContactMessage": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "name": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "phone": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "body": {
            "type": "string"
          },
          "order_number": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "new",
              "replied",
              "archived"
            ]
          },
          "notes": {
            "type": "string",
            "description": "The operator's own, never shown to the shopper."
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "replies": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ContactReply"
            },
            "description": "The thread, oldest first; on a single message only."
          }
        }
      }
    }
  }
}
