          }
        }
      },
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Record a supplier payment",
        "description": "Provisional unless verified is true, which records who said so.",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "schema": {
              "type": "string"
            },
            "description": "Names this attempt, so a retry records one thing."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "supplier_id": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "amount_minor": {
                    "type": "integer",
                    "format": "int64"
                  },
                  "method": {
                    "type": "string"
                  },
                  "paid_on": {
                    "type": "string",
                    "format": "date"
                  },
                  "reference": {
                    "type": "string"
                  },
                  "verified": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The payment's id."
          }
        }
      }
    },
