    "/api/admin/x/retailassistant/documents/{id}/approve": {
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Post a reviewed document to the ledger",
        "description": "A purchase invoice becomes a payable, a credit note a credit, and a payment proof an unverified payment. Refused when anything is missing; figures that do not add up need accept_mismatch, which is audited.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "version": {
                    "type": "integer"
                  },
                  "accept_mismatch": {
                    "type": "boolean"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/retailassistant/documents/{id}/reject": {
