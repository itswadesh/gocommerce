    "/api/admin/x/retailassistant/documents/{id}/remove-file": {
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Delete a reviewed document's original file",
        "description": "The ledger is untouched. Refused while the document still waits for review. Needs retailassistant.write.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The file is gone"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No such document in this store"
          },
          "409": {
            "description": "The document still waits for review"
          }
        }
      }
    },
    "/api/admin/x/retailassistant/documents/{id}/read": {
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Read a PDF or photo with AI, and replace the draft with what it reads",
        "description": "Needs the store's ai_reading setting and an AI gateway that lets documents leave. The document still waits for review, and approving it needs compared_with_file. Needs retailassistant.write.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The document, with what was read"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "description": "No such document in this store"
          },
          "409": {
            "description": "AI reading is off, this kind of file cannot be read, or somebody changed the document meanwhile"
          },
          "502": {
            "description": "The model gave no usable answer"
          }
        }
      }
    },
    "/api/admin/x/retailassistant/export/{kind}": {
      "get": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Download suppliers, bills, payments or credits as CSV",
        "description": "Amounts are decimal, beside their currency. Text that a spreadsheet would run as a formula starts with an apostrophe. Needs retailassistant.read.",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "enum": [
                "suppliers",
                "bills",
                "payments",
                "credits"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "A CSV file",
            "content": {
              "text/csv": {
                "schema": {
                  "type": "string"
                }
              }
