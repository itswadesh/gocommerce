    "/api/admin/x/retailassistant/invoices/{id}/receive": {
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Book in goods that physically arrived",
        "description": "Moves stock through the stock service, once per line. Needs retailassistant.write and inventory.write.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "lines": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "line_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "variant_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "location_id": {
                          "type": "integer",
                          "format": "int64"
                        },
                        "quantity": {
                          "type": "integer"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    }
  }
