{
  "paths": {
    "/x/retailassistant/whatsapp/webhook": {
      "get": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Meta's webhook verification",
        "description": "Answers hub.challenge when hub.verify_token is the install's. The address carries ?store= only to pass the engine's store binding; the sender picks the store.",
        "parameters": [
          {
            "name": "hub.mode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.verify_token",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "hub.challenge",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "The challenge, as plain text."
          },
          "403": {
            "description": "The token does not match."
          }
        }
      },
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Receive WhatsApp messages on the shared number",
        "description": "Signed by Meta in X-Hub-Signature-256. A message goes to the store its sender's number is verified for, once per message id. An unknown sender's file is not kept.",
        "responses": {
          "200": {
            "description": "Received."
          },
          "403": {
            "description": "The signature does not match."
          }
        }
      }
    },
    "/api/admin/x/retailassistant/status": {
      "get": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Whether this store has the assistant on, and whether the install's WhatsApp number is set up",
        "description": "Needs retailassistant.read.",
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/retailassistant/phone-links": {
      "get": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "List the phones linked to this store",
        "description": "Needs retailassistant.links.",
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "post": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Name a phone and issue its code",
        "description": "The number links only once it sends LINK and the code from itself. The code is shown once. Needs retailassistant.links.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "phone": {
                    "type": "string",
                    "description": "With its country code, such as +919876543210."
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The link and its code."
          }
        }
      }
    },
    "/api/admin/x/retailassistant/phone-links/{id}": {
      "patch": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Choose whether this phone gets confirmation messages",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notify": {
                    "type": "boolean"
                  },
                  "language": {
                    "type": "string",
                    "enum": [
                      "en",
                      "hi"
                    ]
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      },
      "delete": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "Stop this phone sending to the store",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/admin/x/retailassistant/documents": {
      "get": {
        "tags": [
          "retail-assistant"
        ],
        "summary": "List documents",
        "description": "Newest first, without their bytes. Needs retailassistant.read.",
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "received",
                "parsing",
                "needs_review",
                "failed",
                "posted",
                "rejected"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Done."
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
