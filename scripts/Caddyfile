# The proxy for the full stack in docker-compose.yml (D143).
#
# ADMIN_DOMAIN is the panel. Every other name is a shop: the storefront serves
# <slug>.<base domain> and each verified store domain, and Caddy gets each
# one's certificate on its first visit, after the engine says the name is a
# store's. A name it does not know gets no certificate, so DNS pointed here by
# a stranger cannot use up the Let's Encrypt allowance.

{
	on_demand_tls {
		ask http://gocommerce:8080/internal/caddy/ask
	}
	{$CADDY_GLOBAL_OPTIONS}
}

{$ADMIN_DOMAIN} {
	# The engine's proxy endpoints are for this network only.
	respond /internal/* 404
	reverse_proxy gocommerce:8080
}

https:// {
	tls {
		on_demand
	}
	reverse_proxy storefront:3000
}
